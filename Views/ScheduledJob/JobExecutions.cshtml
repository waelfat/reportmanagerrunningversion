@model IEnumerable<reportmangerv2.DTOs.JobExecutionsViewModel>
@{
    ViewData["Title"] = "Job Executions";
}
<div class="container mt-4">
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white border-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Error</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white border-0">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-tasks me-2"></i>Job Executions</h2>
        <a href="@Url.Action("Index", "ScheduledJob")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Jobs
        </a>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Procedure Name</th>
                                <th>User Name</th>
                                <th>Date</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Email Sent</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exec in Model)
                            {
                                <tr>
                                    <td>@exec.ProcedureName</td>
                                    <td>@exec.UserName</td>
                                    <td>@exec.ExecutionDate</td>
                                    <td>@exec.Duration</td>
                                    <td>@exec.ExecutionStatus</td>
                                    <td>
                                        @if (exec.EmailSent)
                                        {
                                            <span class="badge bg-success">Sent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Not Sent</span>
                                        }
                                    </td>
                                    <div class="btn-group btn-group-sm">

                                        <td>
                                    
                                            @if (!exec.EmailSent)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary resend-btn"
                                                        data-exec-id="@exec.Id" title="Resend Email">
                                                    <i class="fas fa-envelope"></i> Resend
                                                </button>
                                            }
                                
                                            <!-- Scripts section moved to bottom of file -->
                           <button type="button" class="btn btn-sm btn-outline-primary delete-btn"
                                                data-exec-id="@exec.Id" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        </td>
                                 
                                     
                                            
                                        @* <a asp-controller="DeleteExecution" asp-action="Delete" asp-route-id="@exec.Id"
                                               class="btn btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a> *@
                                              
                                    </div>




                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">No executions found for this job.</div>
    }
</div>
@section Scripts{
    <script>
            function showToast(type, message) {
            if (type === 'success') {
                document.getElementById('successMessage').textContent = message;
                var toast = new bootstrap.Toast(document.getElementById('successToast'));
                toast.show();
            } else {
                document.getElementById('errorMessage').textContent = message;
                var toast = new bootstrap.Toast(document.getElementById('errorToast'));
                toast.show();
            }
        }
            document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.resend-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var execId = this.getAttribute('data-exec-id');
                    var button = this;
                    button.disabled = true;
                    fetch('@Url.Action("ResendEmail", "ScheduledJob")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: 'executionId=' + encodeURIComponent(execId)
                    })
                        .then(async response => {
                            button.disabled = false;
                            if (response.ok) {
                                const msg = await response.text();
                                showToast('success', msg);
                                // Optionally reload page or update row
                                //update row
                                const row = button.closest('tr');
                                if (row) {
                                    row.querySelector('td:nth-child(6)').innerHTML = '<span class="badge bg-success">Sent</span>';
                                    button.remove(); // Remove resend button after successful resend
                                }
                            } else {
                                const msg = await response.text();
                                showToast('error', msg);
                            }
                        })
                        .catch(err => {
                            button.disabled = false;
                            showToast('error', 'Request failed: ' + err);
                        });
                });
            });
        
            document.querySelectorAll('.delete-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (confirm('Are you sure you want to delete this execution?')) {
                        var execId = this.getAttribute('data-exec-id');
                        fetch('@Url.Action("DeleteExecution", "ScheduledJob")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            },
                            body: 'executionId=' + encodeURIComponent(execId)
                        })
                            .then(async response => {
                                if (response.ok) {
                                    const msg = await response.text();
                                    showToast('success', msg);
                                    // Optionally remove row from table
                                    const row = btn.closest('tr');
                                    if (row) row.remove();
                                } else {
                                    const msg = await response.text();
                                    showToast('error', msg);
                                }
                            })
                            .catch(err => {
                                showToast('error', 'Request failed: ' + err);
                            });
                    }
                });
            });
                                        
        });
                                 
          @*                                   // add delete listener
            document.addEventListener('DOMContentLoaded', function () {
            
        }); *@

                                    
    </script>
}