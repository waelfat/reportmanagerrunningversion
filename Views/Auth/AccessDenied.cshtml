@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-5 col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10" style="width: 100px; height: 100px;">
                        <i class="fas fa-lock fa-3x text-primary"></i>
                    </div>
                    <h1 class="mt-4 mb-3 fw-bold">Access Denied</h1>
                    <p class="text-muted mb-4">You do not have permission to view this page. If you believe this is an error, please contact your administrator or sign in with an account that has the required access.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="fas fa-home me-2"></i>Return to Home
                        </a>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </a>
                        }
                    </div>
                </div>
                <div class="card-footer text-center bg-white py-3">
                    <small class="text-muted">Report Manager | Secure access only</small>
                </div>
            </div>
        </div>
    </div>
</div>
