@model IEnumerable<reportmangerv2.Data.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var message = ViewBag.SuccessMessage as string;
    var errorMessage = ViewBag.ErrorMessage as string;
    var adminUserIds = ViewBag.AdminUserIds as HashSet<string> ?? new HashSet<string>();
}

<div class="container mt-4">
   @if (!string.IsNullOrEmpty(message)) {
        <div
            class="alert alert-success alert-dismissible fixed-top text-nowrap  me-1 fade show" role="alert"> <i
            class="fas fa-check-circle me-2"></i>@message <button type="button" class="btn-close"
                                                                  data-bs-dismiss="alert" aria-label="Close"></button> </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert"> <i
                class="fas fa-exclamation-triangle me-2"></i>@errorMessage <button type="button" class="btn-close"
                                                                                   data-bs-dismiss="alert" aria-label="Close"></button> </div>
            }
       
        <h2><i class="fas fa-users me-2"></i>User Management</h2>
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-user-cog me-2"></i>Manage Users
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle me-2"></i>No users found.
                    </div>
                }
                else
                {
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        @if (!user.IsActive)
                                        {
                                            <form asp-action="Activate" method="post" style="display:inline">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i>
                                                    Activate</button>
                                                </form>
                                            }
                                    else
                                            {
                                                <form asp-action="Deactivate" method="post" style="display:inline">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-warning btn-sm"><i class="fas fa-ban"></i>
                                                        Deactivate</button>
                                                    </form>
                                                }
                                                <form asp-action="ResetPassword" method="post" style="display:inline" id="reset-password-@user.Id">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                                            data-bs-target="#resetPasswordConfirmationModal"
                                                            data-reset-form="reset-password-@user.Id"
                                                            data-user-name="@user.FullName"><i class="fas fa-key"></i> Reset
                                                        Password</button>
                                                    </form>
                                                @if (!adminUserIds.Contains(user.Id))
                                                {
                                                    <form asp-action="SetUserAsAdmin" method="post" style="display:inline" id="set-admin-@user.Id">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                                                                data-bs-target="#setAdminConfirmationModal"
                                                                data-admin-form="set-admin-@user.Id"
                                                                data-user-name="@user.FullName"><i class="fas fa-user-shield"></i> Set as Admin</button>
                                                    </form>
                                                }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>}
                        </div>
                    </div>
                </div>

        @section Scripts {
            <div class="modal fade" id="setAdminConfirmationModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title"><i class="fas fa-user-shield text-primary me-2"></i>Confirm Admin Access</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to grant administrator access to <strong id="setAdminUserName"></strong>?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary btn-sm" id="confirmSetAdminButton">
                                <i class="fas fa-user-shield me-1"></i>Set as Admin
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="resetPasswordConfirmationModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm Password Reset</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to reset the password for <strong id="resetPasswordUserName"></strong>?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger btn-sm" id="confirmResetPasswordButton">
                                <i class="fas fa-key me-1"></i>Reset Password
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                const setAdminModal = document.getElementById('setAdminConfirmationModal');
                const confirmSetAdminButton = document.getElementById('confirmSetAdminButton');

                setAdminModal.addEventListener('show.bs.modal', event => {
                    const adminButton = event.relatedTarget;
                    confirmSetAdminButton.dataset.adminForm = adminButton.dataset.adminForm;
                    document.getElementById('setAdminUserName').textContent = adminButton.dataset.userName;
                });

                confirmSetAdminButton.addEventListener('click', () => {
                    document.getElementById(confirmSetAdminButton.dataset.adminForm).submit();
                });

                const resetPasswordModal = document.getElementById('resetPasswordConfirmationModal');
                const confirmResetPasswordButton = document.getElementById('confirmResetPasswordButton');

                resetPasswordModal.addEventListener('show.bs.modal', event => {
                    const resetButton = event.relatedTarget;
                    confirmResetPasswordButton.dataset.resetForm = resetButton.dataset.resetForm;
                    document.getElementById('resetPasswordUserName').textContent = resetButton.dataset.userName;
                });

                confirmResetPasswordButton.addEventListener('click', () => {
                    document.getElementById(confirmResetPasswordButton.dataset.resetForm).submit();
                });
            </script>
        }