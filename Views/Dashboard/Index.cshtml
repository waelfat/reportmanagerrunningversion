@model IEnumerable<reportmangerv2.Domain.Execution>
@{
    ViewBag.Title = "Active Executions Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Active Executions</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Execution ID</th>
            <th>User</th>
            <th>Report/Job</th>
            <th>Status</th>
            <th>Started</th>
            <th>Duration</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="executions-table-body">
        @foreach (var exec in Model)
        {
            <tr id="exec-@exec.Id">
                <td>@exec.Id</td>
                <td>@(exec.User?.FullName ?? exec.UserId)</td>
                <td>@(exec.Report?.Name  ?? exec.ScheduledJob?.ProcedureName + " (JOB)")</td>
                <td class="status">@exec.ExecutionStatus</td>
                <td>@exec.ExecutionDate.ToString("g")</td>
                <td>@exec.Duration</td>
                <td>
                    <button class="btn btn-danger btn-cancel" data-id="@exec.Id">Cancel</button>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <!-- Toast notifications -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100">
        <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="successMessage"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        <div id="errorToast" class="toast align-items-center text-white bg-danger border-0 mt-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="errorMessage"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Cancel confirmation modal -->
    <div class="modal fade" id="dashboardCancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm Cancel</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">Are you sure you want to cancel this execution?</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn btn-danger btn-sm" id="dashboardCancelConfirmBtn">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/dashboard.js"></script>
}